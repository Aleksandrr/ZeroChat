{
  "name": "msger-zero-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "build": "tsc --noEmit false",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e .env -- prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "overrides": {
    "prisma": "^7.9.1",
    "@prisma/client": "7.9.1",
    "hono": "^4.12.5",
    "lodash": "^4.17.23"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.0",
    "@noble/post-quantum": "^0.5.4",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "fastify": "^5.12.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.8.4",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/sinon": "^21.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino": "^10.3.1",
    "prisma": "^7.9.1",
    "prom-client": "^15.1.3",
    "sinon": "^21.0.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
