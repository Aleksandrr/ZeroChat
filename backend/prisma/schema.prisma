// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Signal Protocol models must be added before enums and other models
// for proper dependency ordering

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// === Signal Protocol Keys ===

// DeviceKeys - stores identity key, signed prekey, and references to one-time prekeys
model DeviceKeys {
  id              String   @id @default(uuid())
  userId          String
  deviceId        String   @default(uuid())  // Reference to device's deviceId
  registrationId  Int      @default(0)  // For libsignal compatibility
  
  // Identity Key (публичный ключ пользователя)
  identityKeyPub  String   // Base64 encoded
  
  // Signed Pre-Key (SPK)
  signedPreKeyId Int      @default(0)
  signedPreKeyPub String   // Base64
  signedPreKeySig String   // Base64 подпись SPK
  
  // PQ Kyber Last Resort Pre-Key (optional - can be stored per device)
  pqLastResortPreKey PqLastResortPreKey?
  
  // One-Time Pre-Keys (EC)
  ecOneTimePreKeys OneTimePreKey[]
  
  // PQ One-Time Pre-Keys (Kyber)
  pqOneTimePreKeys PqOneTimePreKey[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, deviceId])
  @@index([userId])
  @@map("device_keys")
}

model OneTimePreKey {
  id              String   @id @default(uuid())
  deviceKeysId    String
  preKeyId        Int      // EC prekey ID
  preKeyPub       String   // Base64 encoded public key
  consumedAt      DateTime?
  createdAt       DateTime @default(now())
  
  // Relations
  deviceKeys DeviceKeys @relation(fields: [deviceKeysId], references: [id], onDelete: Cascade)
  
  @@unique([deviceKeysId, preKeyId])
  @@index([deviceKeysId])
  @@map("ec_one_time_prekeys")
}

model PqOneTimePreKey {
  id              String   @id @default(uuid())
  deviceKeysId    String
  preKeyId        Int      // Kyber prekey ID  
  preKeyPub       String   // Base64 encoded Kyber public key
  preKeySig       String   // Base64 signature of Kyber public key
  consumedAt      DateTime?
  createdAt       DateTime @default(now())
  
  // Relations
  deviceKeys DeviceKeys @relation(fields: [deviceKeysId], references: [id], onDelete: Cascade)
  
  @@unique([deviceKeysId, preKeyId])
  @@index([deviceKeysId])
  @@map("pq_kem_one_time_prekeys")
}

model PqLastResortPreKey {
  id              String   @id @default(uuid())
  deviceKeysId    String   @unique
  preKeyId        Int      @default(0)
  preKeyPub       String   // Base64 encoded Kyber public key
  preKeySig       String   // Base64 signature
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  deviceKeys DeviceKeys @relation(fields: [deviceKeysId], references: [id], onDelete: Cascade)
  
  @@map("pq_kem_last_resort_prekey")
}

// === Sender Keys для групповых чатов ===

model SenderKeyDistribution {
  id              String   @id @default(uuid())
  chatId          String   // Группа
  senderUserId    String   // Кто создал ключ
  deviceId        String   // Устройство отправителя
  
  // Sender Key материал (CRITICAL: should be encrypted at rest!)
  chainKey        String   // Base64 encoded
  signatureKeyPub String   // Base64 public key для подписи
  signatureKeyPriv String   // Base64 private key (CRITICAL: encrypt at rest!)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  sender User @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [deviceId])
  
  @@unique([chatId, senderUserId, deviceId])
  @@index([chatId])
  @@map("sender_key_distribution")
}

model SenderKeyDistributionMessage {
  id              String   @id @default(uuid())
  chatId          String   // Группа
  senderUserId    String   // Отправитель
  receiverUserId  String   // Получатель
  distributionId  String   // ID SenderKeyDistribution
  
  // Зашифрованный distribution message
  message         String   // Base64 encrypted
  
  createdAt       DateTime @default(now())
  
  @@index([chatId, receiverUserId])
  @@index([distributionId])
  @@map("sender_key_distribution_message")
}

model User {
  id          String     @id @default(cuid())
  username    String     @unique
  displayName String?
  password    String
  avatar      String?
  status      UserStatus @default(OFFLINE)
  lastSeen    DateTime?  // Время последней активности пользователя
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  chats      Chat[]
  messages   Message[]
  devices    Device[]
  chatUsers  ChatUser[]
  refreshTokens RefreshToken[]
  
  // Join requests for group approval
  chatJoinRequests ChatJoinRequest[]
  reviewedBy ChatJoinRequest[] @relation("ReviewedBy")

  // Signal Protocol relations
  deviceKeys      DeviceKeys[]
  senderKeyDistributions SenderKeyDistribution[]

  // Read status relations
  readStatuses MessageReadStatus[]

  // Device verification relations
  verificationCodes DeviceVerificationCode[]

  // Sync relations
  syncEvents SyncEvent[]

  // Command Bus relations (folders)
  folders UserFolder[]
  
  // Pending commands for offline delivery
  pendingCommands PendingCommand[]
   
  @@index([username])
  @@map("users")
}

model Chat {
  id          String   @id @default(cuid())
  name        String?
  type        ChatType @default(PRIVATE)
  avatar      String?
  isGroup     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Group-specific fields
  requireApproval    Boolean        @default(false)
  historyAccess     HistoryAccess  @default(ALL)
  inviteCode        String?        @unique
  inviteCodeExpiresAt DateTime?

  // Command Bus fields (folder, archive, mute, pin)
  isMuted           Boolean        @default(false)
  mutedUntil        DateTime?      // ISO timestamp or null (mute forever)
  isPinned          Boolean        @default(false)
  isArchived        Boolean        @default(false)
  description       String?        // Max 500 chars (validated in application)

  // Relations
  messages          Message[]
  chatUsers         ChatUser[]
  joinRequests      ChatJoinRequest[]
  createdBy         User    @relation(fields: [createdById], references: [id])
  createdById       String
  folderItems       ChatFolderItem[]

  @@map("chats")
}

model Message {
  id          String      @id @default(cuid())
  content     String?
  type        MessageType @default(TEXT)
  encrypted   Boolean     @default(false)
  metadata    Json?
  payloadSize Int?        // Размер ciphertext в байтах (для квотирования файлов)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relations
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String
  author    User        @relation(fields: [authorId], references: [id])
  authorId  String
  file      File?
  
  // Read status relations
  readStatuses MessageReadStatus[]

  @@index([chatId, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("messages")
}

model ChatUser {
  id     String @id @default(cuid())
  role   UserRole @default(MEMBER)
  joinedAt DateTime @default(now())
  
  // Read status tracking
  lastReadAt  DateTime? // Last read timestamp for unread count calculation
  unreadCount Int       @default(0) // Unread count cache

  // Relations
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([chatId, userId])
  @@index([userId])
  @@map("chat_users")
}

// Message read status for detailed tracking (supports group chats)
model MessageReadStatus {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  
  // Relations
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([messageId, userId]) // One read status per user per message
  @@index([userId])
  @@index([messageId])
  @@map("message_read_status")
}

// Chat join requests for groups with requireApproval
model ChatJoinRequest {
  id            String   @id @default(cuid())
  chatId        String
  userId        String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  
  // Relations
  chat         Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?   @relation("ReviewedBy", fields: [reviewedById], references: [id])
  
  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@map("chat_join_requests")
}

model Device {
  id           String   @id @default(cuid())
  deviceId     String   @unique
  signalDeviceId Int?    // Signal Protocol device ID (1-127) для криптографии.
                          // Per-user unique (see @@unique below) — Signal Protocol
                          // requires signalDeviceId to be unique within a single
                          // user's device set, NOT globally across all users.
  name         String
  type         DeviceType
  pushToken    String?
  fingerprint  String?  // Отпечаток устройства для верификации
  lastSeen     DateTime?
  verifiedAt   DateTime?  // Дата верификации устройства
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Device verification limits and cooldown
  lastCodeRequestAt DateTime?  // Последний запрос кода верификации
  lockedUntil       DateTime?  // Временная блокировка генерации кода
  generationCount   Int        @default(0)  // Счётчик генераций кода
  failedAttempts    Int        @default(0)  // Счётчик неудачных попыток ввода

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String

  // Signal Protocol relations (via deviceId reference in DeviceKeys)
  senderKeyDistributions SenderKeyDistribution[]

  // Device verification relations
  verificationCodes DeviceVerificationCode[]

  // Sync relations
  syncEvents SyncEvent[]
  
  // Per-user uniqueness for Signal Protocol device IDs (1-127).
  // Signal Protocol requires signalDeviceId to be unique within a single
  // user's device set; the previous global @unique constraint broke
  // multi-user setups because two different users could never share the
  // same numeric Signal device id (e.g. both having device id 1).
  @@unique([userId, signalDeviceId])
  @@index([userId])
  @@map("devices")
}

model File {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimetype    String
  size        Int
  path        String
  encrypted   Boolean  @default(false)
  key         String?
  iv          String?
  createdAt   DateTime @default(now())

  // Relations
  message     Message? @relation(fields: [messageId], references: [id])
  messageId   String? @unique

  @@map("files")
}

// Enums
enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  BUSY
}

enum ChatType {
  PRIVATE
  GROUP
  CHANNEL
  SYSTEM
  FAVORITES
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
  SYSTEM
}

enum HistoryAccess {
  ALL
  FROM_NOW
  NONE
}

enum UserRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  WEB
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String?  @unique  // Deprecated: kept for migration compatibility
  tokenHash String?  // Argon2id hash of the token (preferred)
  userId    String
  deviceId  String?
  familyId  String   @default(uuid())  // Token family for leak detection
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([deviceId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// === Device Verification ===

model DeviceVerificationCode {
  id          String    @id @default(uuid())
  userId      String
  deviceId    String    // device_uuid (deviceId field in Device model)
  codeHash    String    // Argon2 hash of 6-digit code
  attempts    Int       @default(0)  // Number of failed attempts
  createdAt   DateTime  @default(now())
  expiresAt   DateTime  // 3 минуты (согласно ТЗ)
  usedAt      DateTime?
  
  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  
  @@index([userId, deviceId, expiresAt])
  @@map("device_verification_codes")
}

// === Sync Events ===

model SyncEvent {
  id                String   @id @default(uuid())
  userId            String
  deviceId          String
  seq               Int
  entity            String   // 'ui', 'chat', 'message', 'settings', etc.
  entityId          String
  op                String   // 'upsert', 'delete', 'tombstone'
  version           Int      @default(0)
  payloadCiphertext String   // Base64 encrypted payload
  serverReceivedAt  DateTime @default(now())
  
  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  
  @@unique([deviceId, seq])
  @@index([userId, serverReceivedAt])
  @@index([userId, entity, entityId])
  @@map("sync_events")
}

// === Pending Commands for Offline Delivery ===

model PendingCommand {
  id          String   @id
  userId      String
  deviceId    String
  commandType String
  payload     Json
  metadata    Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, deviceId])
  @@index([expiresAt])
  @@map("pending_commands")
}

// === Chat Folders (Command Bus) ===

model UserFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String   // Max 50 chars (validated in application)
  color     String?  // HEX color #RRGGBB (7 chars max)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatItems  ChatFolderItem[]
  
  @@unique([userId, name])
  @@index([userId, order])
  @@map("user_folders")
}

model ChatFolderItem {
  id        String   @id @default(cuid())
  folderId  String
  chatId    String
  
  // Relations
  folder    UserFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  @@unique([folderId, chatId])
  @@index([chatId])
  @@map("chat_folder_items")
}
